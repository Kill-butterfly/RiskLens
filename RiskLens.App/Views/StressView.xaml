<UserControl x:Class="RiskLens.App.Views.StressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <TextBlock Text="情景假设（拖动滑块实时重算）" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding RevenueDelta, StringFormat='收入变动：{0:P0}'}"/>
        <Slider Minimum="-0.3" Maximum="0.3" Value="{Binding RevenueDelta}" TickFrequency="0.05"/>
        <TextBlock Text="{Binding MarginDelta, StringFormat='利润率额外变动：{0:P0}'}"/>
        <Slider Minimum="-0.1" Maximum="0.1" Value="{Binding MarginDelta}" TickFrequency="0.01"/>
        <TextBlock Text="{Binding RateDelta, StringFormat='利率上浮：{0:P0}'}"/>
        <Slider Minimum="0" Maximum="1" Value="{Binding RateDelta}" TickFrequency="0.1"/>

        <TextBlock Text="{Binding CoverageText}" FontSize="18" Margin="0,16,0,4"/>
        <TextBlock Text="{Binding VerdictText}" Foreground="DarkRed"/>

        <Separator Margin="0,16"/>
        <TextBlock Text="蒙特卡洛模拟" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="收入增速均值 N 参数：" VerticalAlignment="Center"/>
            <TextBox Text="{Binding GrowthMeanText}" Width="60" Margin="4,0"/>
            <TextBlock Text="标准差：" VerticalAlignment="Center"/>
            <TextBox Text="{Binding GrowthStdText}" Width="60" Margin="4,0"/>
            <Button Content="运行 10,000 次模拟" Command="{Binding RunMonteCarloCommand}" Padding="12,2"/>
        </StackPanel>
        <TextBlock Text="{Binding McText}" FontFamily="Consolas" Margin="0,8"/>
    </StackPanel>
</UserControl>